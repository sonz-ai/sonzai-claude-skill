FROM python:${PYTHON_BASE_TAG} AS deps
WORKDIR /app
COPY pyproject.toml poetry.lock* requirements.txt* uv.lock* ./
# Prefer in order: uv, poetry, pip. uv is fastest if present.
RUN if [ -f uv.lock ]; then \
      pip install uv && uv sync --frozen --no-dev; \
    elif [ -f poetry.lock ]; then \
      pip install poetry && poetry config virtualenvs.create false && poetry install --no-dev --no-interaction; \
    else \
      pip install --no-cache-dir -r requirements.txt; \
    fi

FROM python:${PYTHON_BASE_TAG}
WORKDIR /app
COPY --from=deps /usr/local/lib/python3.*/site-packages /usr/local/lib/python3.*/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
