# Generated by cto-loop. Versions resolved via version-checker at generation time.
# Stateless variant: no database. Use for webhook handlers, bot bridges, or apps
# that delegate all state to Sonzai's memory layer.

services:
  app:
    build: .
    ports:
      - "${APP_PORT}:${APP_PORT}"
    env_file:
      - .env
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:${APP_PORT}/health || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 20s
